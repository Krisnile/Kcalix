{
  "expo": {
    "name": "零卡",
    "slug": "kcalix",
    "version": "1.0.1",
    "scheme": "kcalix",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kcalix.app"
    },
    "android": {
      "package": "com.kcalix.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E4F8F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#16C098"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "零卡需要访问你的相册，以便你选择自定义头像。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74cf3596-c80d-4dc7-838d-eab0b24f15fb"
      }
    },
    "owner": "krisnile"
  }
}
